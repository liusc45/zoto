# MySQL Configuration for Opticas-Development
# Optimized for production

[mysqld]
# ==========================================
# General Settings
# ==========================================
default-storage-engine = InnoDB
skip-name-resolve = 1
character-set-server = utf8mb4
collation-server = utf8mb4_general_ci

# ==========================================
# Connection Settings
# ==========================================
max_connections = 200
max_connect_errors = 100000
wait_timeout = 600
interactive_timeout = 28800

# ==========================================
# Buffer Settings
# ==========================================
# InnoDB buffer pool size (70-80% of RAM for DB-only server)
innodb_buffer_pool_size = 1G
innodb_log_buffer_size = 16M

# Query cache (disabled in MySQL 8.0, but kept for compatibility)
query_cache_type = 0
query_cache_size = 0

# Thread buffers
thread_cache_size = 16
thread_stack = 256K

# ==========================================
# InnoDB Settings
# ==========================================
# Log file size (256M for production, adjust based on workload)
innodb_log_file_size = 256M

# Log buffer
innodb_log_buffer_size = 16M

# Flush method (O_DIRECT for better performance with Linux)
innodb_flush_method = O_DIRECT

# File per table (enabled for better performance and space management)
innodb_file_per_table = 1

# I/O threads
innodb_read_io_threads = 4
innodb_write_io_threads = 4

# Lock wait timeout (50 seconds)
innodb_lock_wait_timeout = 50

# Deadlock detection
innodb_deadlock_detect = ON

# ==========================================
# Binary Logging
# ==========================================
log_bin = /var/lib/mysql/mysql-bin.log
expire_logs_days = 7
max_binlog_size = 100M
binlog_format = ROW

# ==========================================
# Slow Query Log
# ==========================================
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow-query.log
long_query_time = 2

# ==========================================
# Error Logging
# ==========================================
log_error = /var/log/mysql/error.log
log_error_verbosity = 2

# ==========================================
# Performance Schema
# ==========================================
performance_schema = ON

# ==========================================
# MyISAM Settings (if any tables use MyISAM)
# ==========================================
key_buffer_size = 32M
myisam_sort_buffer_size = 8M

# ==========================================
# Temporary Tables
# ==========================================
tmp_table_size = 64M
max_heap_table_size = 64M

# ==========================================
# Table Open Cache
# ==========================================
table_open_cache = 4000
open_files_limit = 65535

# ==========================================
# Sort Buffer
# ==========================================
sort_buffer_size = 2M
read_buffer_size = 2M
read_rnd_buffer_size = 8M
join_buffer_size = 2M

# ==========================================
# Network Settings
# ==========================================
max_allowed_packet = 64M
net_buffer_length = 16K

# ==========================================
# Character Set
# ==========================================
init_connect = 'SET NAMES utf8mb4'
collation-server = utf8mb4_general_ci
character-set-server = utf8mb4

# ==========================================
# SQL Mode
# ==========================================
sql_mode = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

# ==========================================
# Replication Settings (if needed)
# ==========================================
# server-id = 1
# binlog_do_db = optica_production

[mysql]
default-character-set = utf8mb4

[client]
default-character-set = utf8mb4
port = 3306
