# ===============================================
# OPTICAS-DEVELOPMENT - ENVIRONMENT CONFIGURATION
# ===============================================
# Copy this file to .env and configure your values

# ----------------------------------------------------------------
# APP ENVIRONMENT
# ----------------------------------------------------------------
CI_ENVIRONMENT = development

# ----------------------------------------------------------------
# DATABASE CONNECTION
# ----------------------------------------------------------------
# Default connection (main database)
database.default.DSN = 
database.default.hostname = db
database.default.username = root
database.default.password = root
database.default.database = optica_local
database.default.port = 3306

# Origin database (legacy system connection - optional)
database.origin.DSN = 
database.origin.hostname = localhost
database.origin.username = 
database.origin.password = 
database.origin.database = 
database.origin.port = 3306

# Access database (optional - for reporting/auditing)
database.access.DSN = 
database.access.hostname = localhost
database.access.username = 
database.access.password = 
database.access.database = 
database.access.port = 3306

# Base database (optional - for reference data)
database.base.DSN = 
database.base.hostname = localhost
database.base.username = 
database.base.password = 
database.base.database = 
database.base.port = 3306

# ----------------------------------------------------------------
# APP CONFIGURATION
# ----------------------------------------------------------------
app.baseURL = 'http://localhost:8080/'
app.indexPage = 'index.php'
app.uriProtocol = 'REQUEST_URI'
app.defaultLocale = 'en'
app.negotiateLocale = false
app.supportedLocales = ['en', 'es']

# ----------------------------------------------------------------
# SECURITY
# ----------------------------------------------------------------
# Encryption key - GENERATE WITH: php spark key:generate
encryption.key = 
encryption.driver = OpenSSL
encryption.blockSize = 16
encryption.digest = SHA256

# Session
session.driver = CodeIgniter\Session\Handlers\FileHandler
session.cookieName = ci_session
session.expiration = 7200
session.savePath = WRITEPATH . 'session'
session.matchIP = false
session.timeToUpdate = 300
session.regenerateDestroy = false

# CSRF
global.xssFiltering = false
global.csrfProtection = 'session'
global.csrfTokenName = 'csrf_test_name'
global.csrfHeaderName = 'X-CSRF-TOKEN'
global.csrfCookieName = 'csrf_cookie_name'
global.csrfExpire = 7200
global.csrfRegenerate = true
global.csrfRedirect = true

# ----------------------------------------------------------------
# CACHE
# ----------------------------------------------------------------
cache.handler = file
cache.cachePath = WRITEPATH . 'cache/'
cache.prefix = 
cache.ttl = 60
cache.reserveMem = 32

# ----------------------------------------------------------------
# LOGGING
# ----------------------------------------------------------------
logger.threshold = (ENVIRONMENT === 'production') ? 4 : 9
logger.path = WRITEPATH . 'logs/'

# ----------------------------------------------------------------
# EMAIL
# ----------------------------------------------------------------
email.fromEmail = 
email.fromName = 'Ópticas System'
email.protocol = smtp
email.mailPath = /usr/sbin/sendmail
email.SMTPHost = smtp.gmail.com
email.SMTPUser = 
email.SMTPPass = 
email.SMTPPort = 587
email.SMTPTimeout = 5
email.SMTPCrypto = tls
email.SMTPKeepAlive = false
email.mailType = html

# ----------------------------------------------------------------
# UPLOADS
# ----------------------------------------------------------------
upload.max_size = 10485760
upload.max_width = 0
upload.max_height = 0
upload.max_filename_increment = 100

# ----------------------------------------------------------------
# FILESYSTEM
# ----------------------------------------------------------------
# Public uploads path
public.uploadsPath = 'uploads'

# ----------------------------------------------------------------
# PDF GENERATION
# ----------------------------------------------------------------
# Ticket configuration
pdf.ticket.width = 58  # mm (thermal printer)
pdf.ticket.font = Arial
pdf.ticket.fontSize = 10

# Report configuration
pdf.report.orientation = P
pdf.report.format = A4

# ----------------------------------------------------------------
# BUSINESS LOGIC
# ----------------------------------------------------------------
# Inventory
inventory.minStockAlert = 5
inventory.maxStockWarning = 100

# Sales
sales.defaultPaymentMethod = cash
sales.allowCredit = true
sales.creditMaxDays = 30
sales.creditMaxAmount = 50000

# Promotions
promotions.enabled = true
promotions.autoApply = true

# ----------------------------------------------------------------
# THIRD-PARTY INTEGRATIONS
# ----------------------------------------------------------------
# Payment gateways
payment.stripe.enabled = false
payment.stripe.publicKey = 
payment.stripe.secretKey = 

payment.paypal.enabled = false
payment.paypal.clientId = 
payment.paypal.secret = 

# AWS (optional - for S3 storage)
aws.region = 
aws.accessKeyId = 
aws.secretAccessKey = 
aws.bucket = 

# ----------------------------------------------------------------
# DOCKER CONFIGURATION
# ----------------------------------------------------------------
# Server configuration
SERVER_PORT = 8080

# PHPMyAdmin (if enabled)
PMA_PORT = 8081

# ----------------------------------------------------------------
# DEVELOPMENT ONLY
# ----------------------------------------------------------------
# Debug toolbar (remove in production)
toolbar.enabled = ENVIRONMENT !== 'production'

# Timezone
app.appTimezone = 'America/Mexico_City'
