# ===============================================
# DOCKER ENVIRONMENT CONFIGURATION
# ===============================================
# Copy this file to .env and configure your values

# ----------------------------------------------------------------
# BUILD CONFIGURATION
# ----------------------------------------------------------------
# Build target: development or production
BUILD_TARGET=development

# ----------------------------------------------------------------
# SERVER CONFIGURATION
# ----------------------------------------------------------------
# App base URL (CHANGE THIS FOR PRODUCTION!)
APP_BASE_URL=http://localhost

# Server name for Caddy (domain name)
SERVER_NAME=localhost

# HTTP port (default: 80)
HTTP_PORT=80

# HTTPS port (default: 443)
HTTPS_PORT=443

# ----------------------------------------------------------------
# CODEIGNITER CONFIGURATION
# ----------------------------------------------------------------
# Environment: development, testing, production
CI_ENVIRONMENT=development

# ----------------------------------------------------------------
# DATABASE CONFIGURATION
# ----------------------------------------------------------------
# MySQL connection
DB_HOST=db
DB_PORT=3306

# Database credentials (CHANGE THESE IN PRODUCTION!)
DB_DATABASE=optica_local
DB_USER=optica_user
DB_PASSWORD=optica_password
DB_ROOT_PASSWORD=root

# ----------------------------------------------------------------
# REDIS CONFIGURATION
# ----------------------------------------------------------------
# Redis password (CHANGE THIS IN PRODUCTION!)
REDIS_PASSWORD=redis_password

# ----------------------------------------------------------------
# PHPMYADMIN CONFIGURATION (Development Only)
# ----------------------------------------------------------------
# phpMyAdmin port
PMA_PORT=8081

# ----------------------------------------------------------------
# SECURITY (PRODUCTION)
# ----------------------------------------------------------------
# Encryption key (GENERATE WITH: php spark key:generate)
ENCRYPTION_KEY=

# SSL Certificate (for production)
# Set SSL_CERT_PATH and SSL_KEY_PATH if using custom certificates
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# ----------------------------------------------------------------
# APPLICATION CONFIGURATION
# ----------------------------------------------------------------
# App timezone
APP_TIMEZONE=America/Mexico_City

# Default locale
APP_LOCALE=en

# ----------------------------------------------------------------
# PERFORMANCE TUNING (PRODUCTION)
# ----------------------------------------------------------------
# PHP-FPM max children (adjust based on server RAM)
PHP_FPM_MAX_CHILDREN=50

# InnoDB buffer pool size (adjust based on server RAM)
# Formula: 70-80% of RAM for dedicated DB server
MYSQL_INNODB_BUFFER_POOL=1G

# Redis max memory (in MB)
REDIS_MAX_MEMORY=512

# ----------------------------------------------------------------
# LOGGING (PRODUCTION)
# ----------------------------------------------------------------
# Log level: 9 (all) to 0 (none)
LOG_LEVEL=9

# Enable slow query log (1 = enabled)
SLOW_QUERY_LOG=1

# Slow query threshold (in seconds)
SLOW_QUERY_THRESHOLD=2

# ----------------------------------------------------------------
# DOCKER VOLUMES
# ----------------------------------------------------------------
# Volume driver (local, nfs, etc.)
VOLUME_DRIVER=local

# ----------------------------------------------------------------
# DEVELOPMENT SETTINGS
# ----------------------------------------------------------------
# Enable xdebug (development only)
XDEBUG_ENABLED=false

# xdebug host (for development with IDE)
XDEBUG_HOST=host.docker.internal
XDEBUG_PORT=9003

# ----------------------------------------------------------------
# BACKUP CONFIGURATION
# ----------------------------------------------------------------
# Backup enabled (true/false)
BACKUP_ENABLED=false

# Backup schedule (cron format)
BACKUP_SCHEDULE="0 2 * * *"

# Backup retention days
BACKUP_RETENTION_DAYS=30

# Backup location (local or S3)
BACKUP_LOCATION=local

# S3 configuration (if BACKUP_LOCATION=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1

# ----------------------------------------------------------------
# MONITORING
# ----------------------------------------------------------------
# Enable health checks
HEALTHCHECK_ENABLED=true

# Health check interval (seconds)
HEALTHCHECK_INTERVAL=30

# Health check timeout (seconds)
HEALTHCHECK_TIMEOUT=5

# ----------------------------------------------------------------
# DOCKER COMPOSE PROFILES
# ----------------------------------------------------------------
# Available profiles: dev, worker, production
# Usage: docker-compose --profile dev up -d
COMPOSE_PROFILES=dev

# ----------------------------------------------------------------
# NOTES
# ----------------------------------------------------------------
# 1. For development: use BUILD_TARGET=development
# 2. For production: use BUILD_TARGET=production
# 3. Enable SSL by setting SERVER_NAME to a valid domain
# 4. Change all passwords before deploying to production
# 5. Generate encryption key with: php spark key:generate
# 6. For production, remove the 'dev' profile from COMPOSE_PROFILES
# 7. Adjust memory limits based on available server resources
