# Registry Configuration
CADDY_DOMAIN=registry.luam.ovh

# Caddy Password Hashes
# ⚠️ Generate hashes using:
# docker run --rm caddy:2 caddy hash-password --plaintext 'YOUR_PASSWORD'
#
# Example output: $2a$14$XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

CADDY_ADMIN_PASSWORD_HASH=YOUR_ADMIN_HASH_HERE
CADDY_PUBLIC_PASSWORD_HASH=YOUR_PUBLIC_HASH_HERE
